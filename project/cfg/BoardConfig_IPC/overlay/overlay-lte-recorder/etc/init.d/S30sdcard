#!/bin/sh
# microSD hot-plug: mount when inserted, lazy-unmount when removed.
# Status for other scripts / web page: /tmp/sd.status
#   absent | ok | readonly | unknown (foreign/unreadable fs) | formatting
MNT=/mnt/sdcard
ST=/tmp/sd.status
LOCK=/tmp/sd_format.lock
PIDF=/var/run/sdcard.pid

log() { logger -t sdcard "$*"; }
setst() { [ "$(cat $ST 2>/dev/null)" = "$1" ] || { echo "$1" > "$ST"; log "state: $1"; }; }

sd_dev() {
    if [ -b /dev/mmcblk1p1 ]; then echo /dev/mmcblk1p1
    elif [ -b /dev/mmcblk1 ]; then echo /dev/mmcblk1
    fi
}

is_mounted() { grep -q " $MNT " /proc/mounts; }

try_mount() {
    dev=$1
    mkdir -p "$MNT"
    # busybox blkid does not report the fs type, so just try FAT32 first, then exFAT
    fsck.vfat -a "$dev" >/dev/null 2>&1
    mount -t vfat -o noatime,flush,errors=remount-ro "$dev" "$MNT" 2>/dev/null \
        || mount -t exfat -o noatime "$dev" "$MNT" 2>/dev/null
    if is_mounted; then
        log "mounted $dev ($(awk -v m="$MNT" '$2==m{print $3}' /proc/mounts))"
        check_rw
    else
        setst unknown
    fi
}

check_rw() {
    mkdir -p "$MNT/rec" 2>/dev/null
    if touch "$MNT/rec/.rw" 2>/dev/null; then rm -f "$MNT/rec/.rw"; setst ok
    else setst readonly; fi
}

loop() {
    # keep at most ~3 s of unwritten video in RAM
    echo 300 > /proc/sys/vm/dirty_expire_centisecs
    echo 100 > /proc/sys/vm/dirty_writeback_centisecs
    last=""
    while true; do
        if [ -f "$LOCK" ]; then
            setst formatting
            last=""
        else
            dev=$(sd_dev)
            if [ -z "$dev" ]; then
                if is_mounted; then umount -l "$MNT"; log "card removed"; fi
                setst absent
                last=""
            elif ! is_mounted; then
                # do not hammer a card that failed to mount: retry every 30 s
                now=$(date +%s)
                if [ -z "$last" ] || [ $((now - last)) -ge 30 ]; then
                    last=$now
                    try_mount "$dev"
                fi
            else
                # mounted by someone else or status lost: verify once
                case "$(cat $ST 2>/dev/null)" in ok|readonly) ;; *) check_rw ;; esac
            fi
        fi
        sleep 2
    done
}

case "$1" in
    start)
        printf "Starting SD watcher: "
        loop </dev/null >/dev/null 2>&1 &
        echo $! > "$PIDF"; echo "OK" ;;
    stop)
        [ -f "$PIDF" ] && kill "$(cat $PIDF)" 2>/dev/null
        sync; is_mounted && umount "$MNT" ;;
    restart) "$0" stop; sleep 1; "$0" start ;;
    status) cat "$ST" 2>/dev/null; is_mounted && df -h "$MNT" | tail -1 ;;
esac
exit 0
